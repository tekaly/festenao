rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // festenao_no_api

    //
    // Public projects (standalone & cloud functions supported)
    //
    // Common public doc
    match /public/get/{document=**} {
      allow get: if true;
    }

    // Common (Standalone & Cloud functions supported)

    function subEntityAccessPath(top, topId, entity, entityId, userId) {
      let path = /databases/$(database)/documents/$(top)/$(topId)/access/$(entity)/entity_id/$(entityId)/user_access/$(userId);
      return path;
    }

    function subHasEntityAdminAccess(top, topId, entity, entityId, userId) {
      let path = subEntityAccessPath(top, topId, entity, entityId, userId);
      return exists(path) && get(path).data.admin == true;
    }
    function subHasEntityWriteAccess(top, topId, entity, entityId, userId) {
    	let path = subEntityAccessPath(top, topId, entity, entityId, userId);
      return exists(path) && get(path).data.write == true;
    }
    function subHasEntityReadAccess(top, topId, entity, entityId, userId) {
    	let path = subEntityAccessPath(top, topId, entity, entityId, userId);
      return exists(path) && get(path).data.read == true;
    }

    match /{top}/{topId}/{entity}/{entityId}/{document=**} {
      allow read: if request.auth != null && subHasEntityReadAccess(top, topId, entity, entityId, request.auth.uid);
      allow write: if request.auth != null && subHasEntityWriteAccess(top, topId, entity, entityId, request.auth.uid);
    }

    // Invite
    match /{top}/{topId}/invite/{entity}/invite_id/{inviteId}/invite_entity/{entityId} {
      allow read: if request.auth.uid != null;
    }

    // Should not be necessary - to try once
    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow read: if request.auth != null &&  request.auth.uid == userId;
    }

    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow read, write: if request.auth != null && subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow read, write: if request.auth != null && subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId} {
      allow read: if request.auth.uid == userId;
    }

    //
    // Project Creator (standalone) - 2026-07-27
    //
    // No backend (no cloud functions): the creator of a project (a
    // TkCmsFsProject, identified here generically as top/topId/entity/entityId)
    // can create sub entities directly, without needing a separate access
    // grant document, as long as the project's own `creatorUserId`
    // field matches the requester.
    function subEntityCreatorUserIdMatches(top, topId, entity, entityId, userId) {
    	let doc = get(/databases/$(database)/documents/$(top)/$(topId)/$(entity)/$(entityId));
      return doc.data != null && doc.data.creatorUserId == userId;
    }

    // Top level entity rules, allow creating and getting (if logged in)
    match /{top}/{topId}/{entity}/{entityId} {
      allow create: if request.auth != null
      			&& request.resource.data.keys().hasAll(['creatorUserId'])
            && request.resource.data.creatorUserId == request.auth.uid;
      allow get: if request.auth != null;
    }

    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow create: if request.auth != null && subEntityCreatorUserIdMatches(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow create: if request.auth != null &&  subEntityCreatorUserIdMatches(top, topId, entity, entityId, request.auth.uid);
    }
  }
}
