rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // festenao_no_api

    //
    // Public projects (standalone & cloud functions supported)
    //
    // Common public doc
    match /public/get/{document=**} {
      allow get: if true;
    }

    //
    // Sub Common (Standalone & Cloud functions supported) - update 2026-08-01
    //

    function subHasEntityAccess(top, topId, entity, entityId, userId, access) {
      let doc = get(/databases/$(database)/documents/$(top)/$(topId)/access/$(entity)/entity_id/$(entityId)/user_access/$(userId));
      return doc != null && doc.data.get(access, false) == true;
    }

    function subHasEntityAdminAccess(top, topId, entity, entityId, userId) {
      return subHasEntityAccess(top, topId, entity, entityId, userId, 'admin');
    }
    function subHasEntityWriteAccess(top, topId, entity, entityId, userId) {
      return subHasEntityAccess(top, topId, entity, entityId, userId, 'write');
    }
    function subHasEntityReadAccess(top, topId, entity, entityId, userId) {
      return subHasEntityAccess(top, topId, entity, entityId, userId, 'read');
    }

    // Update 2026-08-01 disallow writing the root doc if not admin

    match /{top}/{topId}/{entity}/{entityId} {
      allow read: if signedIn() && subHasEntityReadAccess(top, topId, entity, entityId, request.auth.uid);
      allow write: if signedIn() && subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);


      match /data/{dataId}/{document=**} {
        allow read: if signedIn() && subHasEntityReadAccess(top, topId, entity, entityId, request.auth.uid);
        allow write: if signedIn() && subHasEntityWriteAccess(top, topId, entity, entityId, request.auth.uid);
      }
    }

    // Invite

    match /{top}/{topId}/invite/{entity}/invite_id/{inviteId}/invite_entity/{entityId} {
      allow read: if signedIn();
    }

    // Access manage

    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow read, write: if signedIn() && subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow read, write: if signedIn() && subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);
    }

    // Access user read

    match /{top}/{topId}/access/{entity}/user_id/{userId}/{document=**} {
      allow read: if signedIn() && request.auth.uid == userId;
    }

    //
    // Project Creator (standalone) - 2026-07-27
    //
    // No backend (no cloud functions): the creator of a project (a
    // TkCmsFsProject, identified here generically as top/topId/entity/entityId)
    // can create sub entities directly, without needing a separate access
    // grant document, as long as the project's own `creatorUserId`
    // field matches the requester.
    function subEntityCreatorUserIdMatches(top, topId, entity, entityId, userId) {
      let doc = get(/databases/$(database)/documents/$(top)/$(topId)/$(entity)/$(entityId));
      return doc != null && doc.data.get('creatorUserId', '__none__') == userId;
    }

    // Top level entity rules, allow creating and getting (if logged in)
    match /{top}/{topId}/{entity}/{entityId} {
      allow create: if signedIn()
      			&& request.resource.data.get('creatorUserId', '__none__') == request.auth.uid;
      allow get: if signedIn();
    }

    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow create: if signedIn() && subEntityCreatorUserIdMatches(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow create: if signedIn() &&  subEntityCreatorUserIdMatches(top, topId, entity, entityId, request.auth.uid);
    }

    //
    // Public access (project) - 2026-08-01
    //
    function subHasEntityPublicReadAccess(top, topId, entity, entityId) {
      let doc = get(/databases/$(database)/documents/$(top)/$(topId)/access/$(entity)/entity_id/$(entityId)/public_access/public);
      return doc != null && doc.data.get('read', false) == true;
    }

    match /{top}/{topId}/{entity}/{entityId}/data/{dataId}/{document=**} {
      allow read: if subHasEntityPublicReadAccess(top, topId, entity, entityId);
    }

    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/public_access/{document} {
      allow read: if true;
      allow write: if signedIn() && subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);
    }

    //
    // Per user private data - 2026-08-02 created
    //
    match /{top}/{topId}/user_prv/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
