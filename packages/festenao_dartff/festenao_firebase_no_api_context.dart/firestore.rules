rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    //
    // Public projects (standalone & cloud functions supported)
    //
    // Common public doc
    match /public/get/{document=**} {
      allow get: if true;
    }

    /// Create an empty record with the same path as the public doc, so that the public doc can be read by the app.
    match /{top}/{topId}/{entity}/{entityId}/public/get/{document=**} {
      allow get
      allow read, write: if subHasEntityWriteAccess(top, topId, entity, entityId, request.auth.uid);
    }


    // Common (Standalone & Cloud functions supported)

    function subHasEntityAdminAccess(top, topId, entity, entityId, userId) {
      return exists(/databases/$(database)/documents/$(top)/$(topId)/access/$(entity)/entity_id/$(entityId)/user_access/$(userId)) &&
             get(/databases/$(database)/documents/$(top)/$(topId)/access/$(entity)/entity_id/$(entityId)/user_access/$(userId)).data.admin == true;
    }
    function subHasEntityWriteAccess(top, topId, entity, entityId, userId) {
      return exists(/databases/$(database)/documents/$(top)/$(topId)/access/$(entity)/entity_id/$(entityId)/user_access/$(userId)) &&
             get(/databases/$(database)/documents/$(top)/$(topId)/access/$(entity)/entity_id/$(entityId)/user_access/$(userId)).data.write == true;
    }
    //
    // Project Creator (standalone)
    //
    // No backend (no cloud functions): the creator of a project (a
    // TkCmsFsProject, identified here generically as top/topId/entity/entityId)
    // can create sub entities directly, without needing a separate access
    // grant document, as long as the project's own `creatorUserId` (or `createUserId`)
    // field matches the requester.
    function subEntityCreatorUserIdMatches(top, topId, entity, entityId, userId) {
      return exists(/databases/$(database)/documents/$(top)/$(topId)/$(entity)/$(entityId)) &&
             (('creatorUserId' in get(/databases/$(database)/documents/$(top)/$(topId)/$(entity)/$(entityId)).data &&
               get(/databases/$(database)/documents/$(top)/$(topId)/$(entity)/$(entityId)).data.creatorUserId == userId) ||
              ('createUserId' in get(/databases/$(database)/documents/$(top)/$(topId)/$(entity)/$(entityId)).data &&
               get(/databases/$(database)/documents/$(top)/$(topId)/$(entity)/$(entityId)).data.createUserId == userId));
    }

    function subHasEntityWriteAccessOrCreator(top, topId, entity, entityId, userId) {
      return subHasEntityWriteAccess(top, topId, entity, entityId, userId) ||
             subEntityCreatorUserIdMatches(top, topId, entity, entityId, userId);
    }

    // Top level entity rules
    match /{top}/{topId}/{entity}/{entityId} {
      allow create: if request.auth != null && request.resource.data.creatorUserId == request.auth.uid);
    }
    match /{top}/{topId}/{entity}/{entityId}/{document=**} {
      allow read, write: if subHasEntityWriteAccess(top, topId, entity, entityId, request.auth.uid);
    }
    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow read, write: if subEntityCreatorUserIdMatches(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow read, write: if subEntityCreatorUserIdMatches(top, topId, entity, entityId, request.auth.uid);
    }

    // Invite
    match /{top}/{topId}/invite/{entity}/invite_id/{inviteId}/invite_entity/{entityId} {
      allow read: if request.auth.uid != null;
    }

    // Sub entities under a top-level entity (e.g. item/itemId or item/itemId/nested/nestedId)
    match /{top}/{topId}/{entity}/{entityId}/{subEntity}/{subEntityId} {
      allow read, write: if subHasEntityWriteAccessOrCreator(top, topId, entity, entityId, request.auth.uid);
    }
    match /{top}/{topId}/{entity}/{entityId}/{subEntity}/{subEntityId}/{document=**} {
      allow read, write: if subHasEntityWriteAccessOrCreator(top, topId, entity, entityId, request.auth.uid);
    }

    // Should not be necessary
    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow read: if request.auth.uid == userId;
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow read: if request.auth.uid == userId;
    }

    match /{top}/{topId}/access/{entity}/entity_id/{entityId}/user_access/{userId} {
      allow read, write: if subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId}/entity_access/{entityId} {
      allow read, write: if subHasEntityAdminAccess(top, topId, entity, entityId, request.auth.uid);
    }

    match /{top}/{topId}/access/{entity}/user_id/{userId} {
      allow read: if request.auth.uid == userId;
    }
  }
}
